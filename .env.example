# ScaleLink Environment Configuration
# Copy to .env and adjust values for your environment

# Application
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SCALELINK_BASE_URL=http://localhost:8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scalink
DB_USER=scalink
DB_PASSWORD=scalink

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (use a strong secret in production — min 256 bits)
JWT_SECRET=scalink-dev-secret-key-must-be-at-least-256-bits-long-for-hs256
JWT_EXPIRATION_MS=86400000

# Cache TTLs (seconds)
CACHE_URL_TTL_SECONDS=86400
CACHE_ANALYTICS_TTL_SECONDS=900
CACHE_DASHBOARD_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=100
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=500

# AWS Deployment (production)
AWS_REGION=us-east-1
EC2_HOST=
EC2_SSH_KEY=
